{
  "version": 2,
  "name": "nibrasgame",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "financial-sim/**",
      "use": "@vercel/static"
    },
    {
      "src": "financial-town-3d/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/financial-sim/?$",
      "dest": "/financial-sim/index.html"
    },
    {
      "src": "/financial-town-3d/?$",
      "dest": "/financial-town-3d/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "x-vercel-skip-toolbar",
          "value": "1"
        }
      ]
    }
  ]
}
